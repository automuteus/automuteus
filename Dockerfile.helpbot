# Builds the help bot that answers questions in the official server's #help forum.
# Build from the repo root: docker build -f Dockerfile.helpbot .
FROM --platform=${BUILDPLATFORM} golang:1.27-alpine AS builder
ARG TARGETOS
ARG TARGETARCH
# hadolint ignore=DL3018
RUN apk add --no-cache git
WORKDIR /src
COPY ./go.mod ./go.sum ./
RUN go mod download
COPY ./ ./
# Same tag and commit versioning as Dockerfile and Dockerfile.galactus.
# hadolint ignore=SC2155
RUN export TAG=$(git describe --tags "$(git rev-list --tags --max-count=1)") && \
    export COMMIT=$(git rev-parse --short HEAD) && \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -installsuffix 'static' -tags timetzdata \
    -ldflags="-X main.version=${TAG} -X main.commit=${COMMIT}" \
    -o /helpbot ./cmd/helpbot

FROM alpine:3.24 AS final
# hadolint ignore=DL3018
RUN apk add --no-cache ca-certificates && \
    addgroup -g 1000 helpbot && \
    adduser -HD -u 1000 -G helpbot helpbot && \
    mkdir -p /app && chown helpbot:helpbot /app
USER helpbot
WORKDIR /app
COPY --from=builder /helpbot /app/helpbot
# Metrics and health probes
EXPOSE 8080
ENTRYPOINT ["./helpbot"]
